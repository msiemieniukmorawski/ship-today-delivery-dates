{
    "name": "ship-today-delivery-dates-env",
    "private": true,
    "description": "Local wp-env environment for ship-today-delivery-dates (http://localhost:8894)",
    "scripts": {
        "env:start": "flock /tmp/roomly-docker.lock wp-env start",
        "env:stop": "wp-env stop",
        "env:destroy": "wp-env destroy",
        "env:cli": "wp-env run cli wp",
        "env:seed": "wp-env run cli bash wp-content/plugins/ship-today-delivery-dates/scripts/env/seed.sh",
        "test:schedule": "wp-env run cli wp eval-file wp-content/plugins/ship-today-delivery-dates/tests/cli-schedule-test.php"
    },
    "devDependencies": {
        "@wordpress/env": "10.39.0"
    }
}
