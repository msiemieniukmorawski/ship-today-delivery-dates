msgid "Show seconds in countdown"
msgstr "Sekunden im Countdown anzeigen"

#: ship-today-delivery-dates.php:2122
msgid ""
"Examples: \"1h 30min 10s\" or \"01:30\" (without seconds). Leave label empty "
"to hide it completely."
msgstr ""
"Beispiele: \"1h 30min 10s\" oder \"01:30\" (ohne Sekunden). Lass die "
"Beschriftung leer, um sie vollständig auszublenden."

