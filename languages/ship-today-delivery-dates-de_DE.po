#. Plugin Name of the plugin
#: ship-today-delivery-dates.php
msgid "Ship Today & Delivery Dates for WooCommerce"
msgstr "Ship Today & Delivery Dates for WooCommerce"

#. Description of the plugin
#: ship-today-delivery-dates.php
msgid ""
"Countdown to the order cutoff time with the next ship and delivery dates "
"(shortcode [stdd_notice]), plus an optional ship date choice at checkout."
msgstr ""
"Countdown bis zum Bestellschluss mit dem nächsten Versand- und Liefertermin "
"(Shortcode [stdd_notice]) sowie optionale Auswahl des Versandtermins im "
"Checkout."

#. Author of the plugin
#: ship-today-delivery-dates.php
msgid "MS-M.pl"
msgstr "MS-M.pl"

#. Author URI of the plugin
#: ship-today-delivery-dates.php
msgid "https://ms-m.pl"
msgstr "https://ms-m.pl"

