#. Plugin Name of the plugin
#: wc-ship-today-notice.php
msgid "Powiadomienie o wysyłce dziś"
msgstr "Benachrichtigung über heutigen Versand"

#. Description of the plugin
#: wc-ship-today-notice.php
msgid ""
"Countdown to the order cutoff time with the next ship and delivery dates "
"(shortcode [ship_today_notice]), plus an optional ship date choice at "
"checkout."
msgstr ""
"Countdown bis zum Bestellschluss mit dem nächsten Versand- und Liefertermin "
"(Shortcode [ship_today_notice]) sowie optionale Auswahl des Versandtermins "
"im Checkout."

#. Author of the plugin
#: wc-ship-today-notice.php
msgid "MS-M.pl"
msgstr "MS-M.pl"

#. Author URI of the plugin
#: wc-ship-today-notice.php
msgid "https://ms-m.pl"
msgstr "https://ms-m.pl"

