#. Plugin Name of the plugin
#: wc-ship-today-notice.php
msgid "Powiadomienie o wysyłce dziś"
msgstr "Powiadomienie o wysyłce dziś"

#. Description of the plugin
#: wc-ship-today-notice.php
msgid ""
"Countdown to the order cutoff time with the next ship and delivery dates "
"(shortcode [ship_today_notice]), plus an optional ship date choice at "
"checkout."
msgstr ""
"Odliczanie do godziny granicznej z najbliższą datą wysyłki i dostawy "
"(shortcode [ship_today_notice]) oraz opcjonalny wybór terminu wysyłki w "
"checkoucie."

#. Author of the plugin
#: wc-ship-today-notice.php
msgid "MS-M.pl"
msgstr "MS-M.pl"

#. Author URI of the plugin
#: wc-ship-today-notice.php
msgid "https://ms-m.pl"
msgstr "https://ms-m.pl"

